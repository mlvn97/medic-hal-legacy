{
    "name": "mlvn97/medic-hal-legacy",
    "require": {
        "php": ">=8.3",
        "sabre/vobject": "^4.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {"App\\": "src/"}
    },
    "scripts": {
        "seed": "@php bin/seed.php",
        "start": "@php -S 127.0.0.1:8000 -t public public/index.php",
        "start:demo-calendar": [
            "@putenv PRACTITIONER_ICAL_CALENDARS={\"pract-101\":{\"source\":\"data/demo/pract-101.ics\",\"timezone\":\"Europe/Paris\"}}",
            "@start"
        ],
        "swagger": "@start",
        "test": "phpunit"
    }
}
